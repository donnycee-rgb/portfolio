# Copy to .env.local for `vercel dev`; on Vercel, set these in Project → Settings → Environment Variables.
# Contact form email (any SMTP account). Gmail: smtp.gmail.com, port 465, your address, and an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where messages go (defaults to SMTP_USER) and the sender shown
CONTACT_TO=
CONTACT_FROM=
